{
    "name": "mporcheron/clacks-overhead",
    "type": "roundcube-plugin",
    "description": "Plugin to append outgoing mail from Roundcube with the header X-Clacks-Overhead: GNU Terry Pratchett",
    "keywords": [
        "gnu",
        "terry pratchett",
        "clacks",
        "clacks overhead"
    ],
    "homepage": "https://github.com/mporcheron/roundcube-clacks-overhead",
    "license": "MIT",
    "authors": [
        {
            "name": "Martin Porcheron",
            "email": "martin@porcheron.uk",
            "homepage": "https://www.porcheron.uk",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://plugins.roundcube.net"
        }
    ],
    "support": {
        "email": "martin@porcheron.uk",
        "issues": "https://github.com/mporcheron/roundcube-clacks-overhead/issues"
    },
    "require": {
        "php": ">=7.4.0",
        "roundcube/plugin-installer": ">=0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
