# Copy to .env (or export these before `docker compose up`) to configure
# the E2E stack. docker-compose.yml auto-loads .env from this directory.

# Which Roundcube image tag to test against. Format: <version>-<variant>
# Confirmed on Docker Hub: 1.6.x-apache, 1.6.17-apache, latest-apache,
# 1.7.x-apache. (Note: "1.6-apache" without ".x" does NOT exist - that's
# the mistake that caused "manifest unknown".)
ROUNDCUBE_TAG=1.6.x-apache

# Login used by Playwright and by the fixture-injection script as the
# recipient mailbox. GreenMail's test setup runs with auth disabled by
# default, so any password works and the mailbox is created on first use.
# Must contain a dot in the domain: Roundcube's own recipient validation
# (rcube_utils::check_email()) rejects "tester@localhost" as an invalid
# address when composing, even though it's perfectly fine for IMAP login.
# ".test" is an IANA-reserved TLD meant exactly for this (RFC 2606).
TEST_USER=tester@example.test
TEST_PASS=testpass

ROUNDCUBE_BASE_URL=http://localhost:8080
GREENMAIL_SMTP_HOST=localhost
GREENMAIL_SMTP_PORT=3025
GREENMAIL_IMAP_HOST=localhost
GREENMAIL_IMAP_PORT=3143
